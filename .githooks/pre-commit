#!/bin/sh
# Bloque le commit si la suite de tests echoue (code de sortie de pytest != 0).
ROOT="$(git rev-parse --show-toplevel)"
if [ -x "$ROOT/.venv/Scripts/python.exe" ]; then
  PY="$ROOT/.venv/Scripts/python.exe"
elif [ -x "$ROOT/.venv/bin/python" ]; then
  PY="$ROOT/.venv/bin/python"
else
  PY=python
fi
"$PY" -m pytest -q
status=$?
if [ $status -ne 0 ]; then
  echo "pre-commit : pytest a echoue (code $status), commit bloque." >&2
  exit 1
fi
